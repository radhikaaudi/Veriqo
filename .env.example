# ---- Backend env (copy to backend/.env for local, or set on Cloud Run) ----

# Mode switches — all default to the runnable mock/local path.
GEMINI_MODE=mock          # mock | live
VAHAN_MODE=mock           # mock | live
STORE_MODE=memory         # memory | firestore

# Gemini on Vertex AI (set when GEMINI_MODE=live)
USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000   # fail fast with a clear 504 instead of hanging
# Only if USE_VERTEX=false (AI Studio key instead of Vertex). Never commit a real key;
# on Cloud Run use Secret Manager (--set-secrets), never a plain env var in the repo.
# GEMINI_API_KEY=

# Cloud Storage for evidence photos (optional; empty = local placeholder URIs)
GCS_BUCKET=

# VAHAN RC provider (set when VAHAN_MODE=live) — Surepass/Signzy/Zoop/Gridlines.
# In mock mode ONLY the synthetic plates in backend/fixtures/rc_fixtures.json return data;
# every other plate is reported as "not verified".
VAHAN_API_URL=
VAHAN_API_KEY=

# CORS: comma-separated origins, or * for dev
CORS_ORIGINS=*
